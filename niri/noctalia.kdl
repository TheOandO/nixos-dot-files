layout {

    focus-ring {
        active-color   "#c1af8b"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#c1af8b"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#c1af8b"
        inactive-color "#6a572f"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#c1af8b80"
    }
}

recent-windows {
    highlight {
        active-color "#c1af8b"
        urgent-color "#fd4663"
    }
}
