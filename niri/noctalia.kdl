layout {

    focus-ring {
        active-color   "#8b98c1"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8b98c1"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#8b98c1"
        inactive-color "#2f3d6a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8b98c180"
    }
}

recent-windows {
    highlight {
        active-color "#8b98c1"
        urgent-color "#fd4663"
    }
}
