layout {

    focus-ring {
        active-color   "#bdc4f2"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bdc4f2"
        inactive-color "#131316"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bdc4f2"
        inactive-color "#565d85"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bdc4f280"
    }
}

recent-windows {
    highlight {
        active-color "#bdc4f2"
        urgent-color "#ffb4ab"
    }
}
