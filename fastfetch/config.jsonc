{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
      "type": "auto",        // Logo type: auto, builtin, small, file, etc.
      "source": "~/.config/fastfetch/logo.txt",      // Built-in logo name or file pat
      "padding": {
          "top": 4,          // Top padding
          "left": 0,         // Left padding
          "right": 2         // Right padding
      },
      "color": {             // Override logo colors
          "1": "red",
      }
  },
  "modules": [
    "title",
    "colors",
    "break",
    "separator",
    "os",
    "kernel",
    "uptime",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "font",
    "bluetooth",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "media",
    "localip",
  ]
}
